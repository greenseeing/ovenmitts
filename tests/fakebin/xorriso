#!/bin/sh
# Fake xorriso: dispatches on argv exactly like the pipeline invokes the real
# tool (probe / -as mkisofs / -as cdrecord / -md5 on -check_media / report_lba).
# Transcripts come from the real-output fixtures in ../fixtures.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
fixtures="$here/../fixtures"

if [ "${1:-}" = "-outdev" ] && [ "${3:-}" = "-toc" ]; then
    cat "$fixtures/xorriso_probe_bdr_blank_full.txt"
    exit 0
fi

if [ "${1:-}" = "-as" ] && [ "${2:-}" = "mkisofs" ]; then
    shift 2
    iso=""
    prev=""
    for a in "$@"; do
        if [ "$prev" = "-o" ]; then iso="$a"; fi
        prev="$a"
    done
    if [ -z "$iso" ]; then
        echo "fake xorriso: -as mkisofs without -o" >&2
        exit 2
    fi
    contents="$iso.contents"
    rm -rf "$contents"
    mkdir -p "$contents"
    : > "$iso"
    grafting=0
    for a in "$@"; do
        if [ "$grafting" = 0 ]; then
            if [ "$a" = "-graft-points" ]; then grafting=1; fi
            continue
        fi
        target=${a%%=*}
        source=${a#*=}
        dest="$contents$target"
        mkdir -p "$(dirname "$dest")"
        if [ -d "$source" ]; then
            cp -R "$source" "$dest"
            find "$source" -type f | LC_ALL=C sort | while IFS= read -r f; do
                cat "$f" >> "$iso"
            done
        else
            cp "$source" "$dest"
            cat "$source" >> "$iso"
        fi
    done
    # Wrap the concatenated payload in a minimal ISO 9660 shell (16 zero
    # sectors + a PVD declaring the exact block count) so the truncation
    # self-check can parse the image like a real one.
    data_size=$(wc -c < "$iso")
    pad=$(( (2048 - data_size % 2048) % 2048 ))
    total=$(( 32768 + 2048 + data_size + pad ))
    blocks=$(( total / 2048 ))
    {
        head -c 32768 /dev/zero
        printf '\001CD001\001'
        head -c 73 /dev/zero
        # volume space size, little-endian u32 at PVD offset 80
        printf "$(printf '\\%03o\\%03o\\%03o\\%03o' $((blocks & 255)) $(((blocks >> 8) & 255)) $(((blocks >> 16) & 255)) $(((blocks >> 24) & 255)))"
        head -c 44 /dev/zero
        # logical block size 2048, little-endian u16 at offset 128
        printf '\000\010'
        head -c 1918 /dev/zero
        cat "$iso"
        if [ "$pad" -gt 0 ]; then head -c "$pad" /dev/zero; fi
    } > "$iso.wrap"
    mv "$iso.wrap" "$iso"
    printf 'xorriso : UPDATE :  25.00%% done\n' >&2
    printf 'xorriso : UPDATE :  50.00%% done, estimate finish Thu Jul 17 00:00:00 2026\n' >&2
    printf 'xorriso : UPDATE :  99.05%% done\n' >&2
    printf 'ISO image produced: %s sectors\n' "$(( ($(wc -c < "$iso") + 2047) / 2048 ))" >&2
    exit 0
fi

if [ "${1:-}" = "-outdev" ] && [ "${3:-}" = "-format" ]; then
    printf 'xorriso : UPDATE : Formatting  100.0%%\n' >&2
    exit 0
fi

if [ "${1:-}" = "-as" ] && [ "${2:-}" = "cdrecord" ]; then
    shift 2
    : "${OVENMITTS_FAKE_DEVICE:?fake xorriso: OVENMITTS_FAKE_DEVICE unset}"
    printf '%s\n' "$@" > "$OVENMITTS_FAKE_DEVICE.cdrecord_argv"
    dev=""
    iso=""
    for a in "$@"; do
        case "$a" in
            dev=*) dev=${a#dev=} ;;
            -*|*=*) ;;
            *) iso="$a" ;;
        esac
    done
    if [ -z "$dev" ] || [ -z "$iso" ]; then
        echo "fake xorriso: -as cdrecord needs dev= and an ISO argument" >&2
        exit 2
    fi
    if [ -n "${OVENMITTS_FAKE_BURN_FAIL:-}" ]; then
        # real Verbatim-43887 failure transcript shape: keepalives, then cause
        i=267
        while [ "$i" -le 273 ]; do
            printf 'xorriso : UPDATE : Thank you for being patient. Working since %s seconds.\n' "$i" >&2
            i=$((i+1))
        done
        printf 'xorriso : FAILURE : libburn indicates failure with writing.\n' >&2
        printf "xorriso : NOTE : Gave up -outdev ''\n" >&2
        printf "xorriso : NOTE : Giving up for -eject whole -dev ''\n" >&2
        printf 'xorriso : FAILURE : -as cdrecord: Job could not be performed properly.\n' >&2
        printf "xorriso : aborting : -abort_on 'FAILURE' encountered 'FATAL'\n" >&2
        exit 5
    fi
    cp "$iso" "$OVENMITTS_FAKE_DEVICE"
    printf 'xorriso : UPDATE :  4 of 8 MB written (fifo 97%%) [buf  94%%]   4.0x.\n' >&2
    printf 'xorriso : UPDATE : Writing:    4096s  100.0%%   fifo   0%%  buf  99%%  4.0xD\n' >&2
    printf "Writing to '%s' completed successfully.\n" "$dev"
    exit 0
fi

if [ "${1:-}" = "-md5" ] && [ "${2:-}" = "on" ] && [ "${5:-}" = "-check_media" ]; then
    cat "$fixtures/check_media_clean.txt"
    exit 0
fi

if [ "${1:-}" = "-indev" ] && [ "${3:-}" = "-find" ]; then
    printf 'Report layout: xt , Startlba ,   Blocks , Filesize , ISO image path\n'
    printf "File data lba:  0 ,       32 ,     4096 ,  8388608 , '/vault.hc'\n"
    printf "File data lba:  0 ,     4128 ,     1536 ,  3145728 , '/notes.bin'\n"
    exit 0
fi

echo "fake xorriso: unhandled argv: $*" >&2
exit 1
